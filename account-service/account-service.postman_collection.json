{
  "info": {
    "name": "TNF account-service",
    "description": "Account service endpoints (port 8083). Set the {{baseUrl}} variable. Run 'Create SAVINGS' first to auto-populate {{savingsAccount}}.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8083" },
    { "key": "customerId", "value": "CUST-1" },
    { "key": "savingsAccount", "value": "" },
    { "key": "currentAccount", "value": "" }
  ],
  "item": [
    {
      "name": "Create SAVINGS account",
      "event": [
        { "listen": "test", "script": { "exec": [
          "pm.test('201 Created', () => pm.response.code === 201);",
          "pm.collectionVariables.set('savingsAccount', pm.response.json().accountNumber);"
        ], "type": "text/javascript" } }
      ],
      "request": {
        "method": "POST",
        "header": [ { "key": "Content-Type", "value": "application/json" } ],
        "url": { "raw": "{{baseUrl}}/api/accounts", "host": ["{{baseUrl}}"], "path": ["api","accounts"] },
        "body": { "mode": "raw", "raw": "{\n  \"customerId\": \"{{customerId}}\",\n  \"accountType\": \"SAVINGS\",\n  \"initialDeposit\": 1000,\n  \"minimumBalance\": 500,\n  \"interestRate\": 0.04\n}" }
      }
    },
    {
      "name": "Create CURRENT account",
      "event": [
        { "listen": "test", "script": { "exec": [
          "pm.test('201 Created', () => pm.response.code === 201);",
          "pm.collectionVariables.set('currentAccount', pm.response.json().accountNumber);"
        ], "type": "text/javascript" } }
      ],
      "request": {
        "method": "POST",
        "header": [ { "key": "Content-Type", "value": "application/json" } ],
        "url": { "raw": "{{baseUrl}}/api/accounts", "host": ["{{baseUrl}}"], "path": ["api","accounts"] },
        "body": { "mode": "raw", "raw": "{\n  \"customerId\": \"{{customerId}}\",\n  \"accountType\": \"CURRENT\",\n  \"initialDeposit\": 200,\n  \"overdraftLimit\": 1000\n}" }
      }
    },
    {
      "name": "Get account by number",
      "request": {
        "method": "GET",
        "url": { "raw": "{{baseUrl}}/api/accounts/{{savingsAccount}}", "host": ["{{baseUrl}}"], "path": ["api","accounts","{{savingsAccount}}"] }
      }
    },
    {
      "name": "Get accounts by customer",
      "request": {
        "method": "GET",
        "url": { "raw": "{{baseUrl}}/api/accounts/customer/{{customerId}}", "host": ["{{baseUrl}}"], "path": ["api","accounts","customer","{{customerId}}"] }
      }
    },
    {
      "name": "Deposit",
      "request": {
        "method": "POST",
        "header": [ { "key": "Content-Type", "value": "application/json" } ],
        "url": { "raw": "{{baseUrl}}/api/accounts/{{savingsAccount}}/deposit", "host": ["{{baseUrl}}"], "path": ["api","accounts","{{savingsAccount}}","deposit"] },
        "body": { "mode": "raw", "raw": "{\n  \"amount\": 250\n}" }
      }
    },
    {
      "name": "Withdraw",
      "request": {
        "method": "POST",
        "header": [ { "key": "Content-Type", "value": "application/json" } ],
        "url": { "raw": "{{baseUrl}}/api/accounts/{{savingsAccount}}/withdraw", "host": ["{{baseUrl}}"], "path": ["api","accounts","{{savingsAccount}}","withdraw"] },
        "body": { "mode": "raw", "raw": "{\n  \"amount\": 100\n}" }
      }
    },
    {
      "name": "Transfer (needs Mongo replica set)",
      "request": {
        "method": "POST",
        "header": [ { "key": "Content-Type", "value": "application/json" } ],
        "url": { "raw": "{{baseUrl}}/api/accounts/{{savingsAccount}}/transfer", "host": ["{{baseUrl}}"], "path": ["api","accounts","{{savingsAccount}}","transfer"] },
        "body": { "mode": "raw", "raw": "{\n  \"targetAccountNumber\": \"{{currentAccount}}\",\n  \"amount\": 300\n}" }
      }
    },
    {
      "name": "Transaction history",
      "request": {
        "method": "GET",
        "url": { "raw": "{{baseUrl}}/api/accounts/{{savingsAccount}}/transactions", "host": ["{{baseUrl}}"], "path": ["api","accounts","{{savingsAccount}}","transactions"] }
      }
    },
    {
      "name": "Health check",
      "request": {
        "method": "GET",
        "url": { "raw": "{{baseUrl}}/actuator/health", "host": ["{{baseUrl}}"], "path": ["actuator","health"] }
      }
    }
  ]
}
